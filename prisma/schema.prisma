generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

generator pothos {
  provider     = "prisma-pothos-types"
  output       = "../generated/pothos-prisma-types.ts"
  clientOutput = "./prisma"
}

datasource db {
  provider = "postgresql"
}

model Audits {
  idAudit   Int      @id @default(autoincrement()) @map("id_audit")
  idUnit    Int      @unique @map("id_unit")
  dateAudit DateTime @map("date_audit") @db.Date

  @@unique([idUnit, dateAudit], name: "unique_audit", map: "unique_audit")
  @@map("audits")
}

model AuthChem {

  idAuthChem               Int                        @id @default(autoincrement()) @map("id_auth_chem")
  casAuthChem              String                     @unique(map: "cas_auth_chem") @map("cas_auth_chem") @db.VarChar(100)
  authChemEn               String                     @unique(map: "auth_chem_en") @map("auth_chem_en") @db.VarChar(500)
  authChemFr               String?                    @map("auth_chem_fr") @db.VarChar(500)
  flagAuthChem             Boolean                    @map("flag_auth_chem")
  fastway                  Boolean?
  authCode                 String?                    @map("auth_code")
  authorizationHasChemical AuthorizationHasChemical[]

  @@map("auth_chem")
}

model BioOrg {
  idBioOrg  Int       @id @default(autoincrement()) @map("id_bio_org")
  organism  String    @db.VarChar(100)
  riskGroup Int       @map("risk_group")
  filePath  String?   @db.VarChar(250)
  updatedOn DateTime? @map("updated_on") @db.Date
  updatedBy String?   @map("updated_by") @db.VarChar(50)

  @@unique([organism, riskGroup], name: "org_risk", map: "org_risk")
  @@map("bio_org")
}

model School {
  id        Int         @id @default(autoincrement()) @map("id_faculty")
  name      String?     @unique(map: "unique_faculty") @map("name_faculty") @db.VarChar(20)
  institute Institute[]

  @@map("faculty")
}

model Institute {
  id       Int     @id @default(autoincrement()) @map("id_institut")
  name     String? @map("name_institut") @db.VarChar(60)
  idSchool Int     @map("id_faculty")
  school   School  @relation(fields: [idSchool], references: [id], onUpdate: Restrict, map: "institut_ibfk_1")
  unit     Unit[]

  @@unique([name, idSchool], name: "unique_institut", map: "unique_institut")
  @@index([idSchool], map: "id_faculty")
  @@map("institut")
}

model Room {
  id                           Int                           @id @default(autoincrement()) @map("id_lab")
  sciperLab                    Int?                          @unique(map: "unique_sciper_lab") @map("sciper_lab")
  site                         String?                       @db.VarChar(50)
  building                     String                        @db.VarChar(5)
  sector                       String?                       @db.VarChar(5)
  floor                        String?                       @db.VarChar(5)
  roomNo                       String                        @map("lab") @db.VarChar(10)
  idLabType                    Int?                          @map("id_labType")
  labTypeIsDifferent           Boolean                       @default(false) @map("lab_type_is_different")
  description                  String?                       @db.VarChar(200)
  location                     String?                       @db.VarChar(10)
  vol                          Float?
  vent                         String?                       @db.Char(1)
  name                         String?                       @map("lab_display") @db.VarChar(20)
  isDeleted                    Boolean                       @default(false)
  assessmentAndDecisionHasRoom AssessmentDecisionHasRoom[]
  authorizationHasRoom         AuthorizationHasRoom[]
  dispensationHasRoom          DispensationHasRoom[]
  kind                         RoomKind?                     @relation(fields: [idLabType], references: [idLabType], onDelete: Restrict, onUpdate: Restrict, map: "lab_ibfk_1")
  labHasHazards                LabHasHazards[]
  labHasHazardsAdditionalInfo  LabHasHazardsAdditionalInfo[]
  unitHasRoom                  UnitHasRoom[]

  @@unique([building, sector, floor, roomNo], name: "unique_lab", map: "unique_lab")
  @@unique([sciperLab, building, sector, floor, roomNo], name: "unique_labo", map: "unique_labo")
  @@index([idLabType], map: "id_labType")
  @@map("lab")
}

model RoomKind {
  idLabType        Int     @id @default(autoincrement()) @map("id_labType")
  name             String? @map("labType") @db.VarChar(100)
  idLabTypeCristal String? @map("id_labTypeCristal")
  room             Room[]

  @@map("labType")
}

model UnitHasRoom {
  idUnit Int  @map("id_unit")
  idLab  Int  @map("id_lab")
  unit   Unit @relation(fields: [idUnit], references: [id], onUpdate: Restrict, map: "unit_has_room_ibfk_1")
  room   Room @relation(fields: [idLab], references: [id], onUpdate: Restrict, map: "unit_has_room_ibfk_2")

  @@unique([idUnit, idLab], name: "unique_unit_has_room", map: "unique_unit_has_room")
  @@index([idLab])
  @@map("unit_has_room")
}

model UnitHasCosec {
  idUnit   Int    @map("id_unit")
  idPerson Int    @map("id_person")
  unit     Unit   @relation(fields: [idUnit], references: [id], onUpdate: Restrict, map: "unit_has_cosec_ibfk_1")
  cosec    Person @relation(fields: [idPerson], references: [idPerson], onUpdate: Restrict, map: "unit_has_cosec_ibfk_2")

  @@unique([idUnit, idPerson], name: "unique_unit_has_person", map: "unique_unit_has_person")
  @@index([idPerson])
  @@map("unit_has_cosec")
}

model Person {
  idPerson                        Int                            @id @default(autoincrement()) @map("id_person")
  sciper                          Int?                           @unique(map: "unique_sciper")
  name                            String?                        @map("name_person") @db.VarChar(60)
  surname                         String?                        @map("surname_person") @db.VarChar(60)
  email                           String?                        @map("email_person") @db.VarChar(60)
  assessmentAndDecisionHasContact AssessmentDecisionHasContact[]
  authorizationHasHolder          AuthorizationHasHolder[]
  dispensationHasHolder           DispensationHasHolder[]
  subunpro                        Subunpro[]
  responsibleForUnits             Unit[]
  unitHasCosec                    UnitHasCosec[]

  @@unique([name, surname, email], name: "unique_per", map: "unique_per")
  @@unique([sciper, name, surname, email], name: "unique_person", map: "unique_person")
  @@map("person")
}

model Subunpro {
  idSubunpro Int     @id @default(autoincrement()) @map("id_subunpro")
  idUnit     Int?    @map("id_unit")
  idPerson   Int?    @map("id_person")
  idSubject  String? @map("id_subject") @db.Char(2)
  unit       Unit?   @relation(fields: [idUnit], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "subunpro_ibfk_1")
  person     Person? @relation(fields: [idPerson], references: [idPerson], onDelete: Restrict, onUpdate: Restrict, map: "subunpro_ibfk_2")

  @@unique([idUnit, idPerson], name: "unique_subunpro", map: "unique_subunpro")
  @@index([idPerson])
  @@index([idUnit])
  @@map("subunpro")
}

model Unit {
  id                           Int                         @id @default(autoincrement()) @map("id_unit")
  unitId                       Int?                        @unique(map: "unique_sciper_unit") @map("sciper_unit")
  name                         String?                     @map("name_unit") @db.VarChar(60)
  idInstitute                  Int?                        @map("id_institut")
  responsibleId                Int?                        @map("responsible_id")
  assessmentAndDecisionHasUnit AssessmentDecisionHasUnit[]
  authorization                Authorization[]
  dispensationHasUnit          DispensationHasUnit[]
  subunpro                     Subunpro[]
  responsible                  Person?                     @relation(fields: [responsibleId], references: [idPerson], onUpdate: Restrict, map: "unit_has_responsible")
  institute                    Institute?                  @relation(fields: [idInstitute], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "unit_ibfk_1")
  unitHasCosec                 UnitHasCosec[]
  unitHasRoom                  UnitHasRoom[]

  @@unique([name, idInstitute], name: "unique_un", map: "unique_un")
  @@unique([unitId, name, idInstitute], name: "unique_unit", map: "unique_unit")
  @@index([idInstitute], map: "id_institut")
  @@index([responsibleId], map: "responsible_id")
  @@map("unit")
}

model HazardCategory {
  idHazardCategory            Int                           @id @default(autoincrement()) @map("id_hazard_category")
  hazardCategoryName          String                        @unique(map: "unique_hazard_category_name") @map("hazard_category_name") @db.VarChar(60)
  hazardForm                  HazardForm?
  labHasHazardsAdditionalInfo LabHasHazardsAdditionalInfo[]

  @@map("hazard_category")
}

model HazardForm {
  idHazardForm      Int                 @id @default(autoincrement()) @map("id_hazard_form")
  idHazardCategory  Int                 @unique @map("id_hazard_category")
  form              String
  version           String              @default("1.0.0")
  hazardCategory    HazardCategory      @relation(fields: [idHazardCategory], references: [idHazardCategory])
  hazardFormChild   HazardFormChild[]
  hazardFormHistory HazardFormHistory[]

  @@index([idHazardCategory], map: "id_hazard_category")
  @@map("hazard_form")
}

model HazardFormHistory {
  idHazardFormHistory Int             @id @default(autoincrement()) @map("id_hazard_form_history")
  idHazardForm        Int             @map("id_hazard_form")
  form                String
  version             String          @default("1.0.0")
  modifiedBy          String          @map("modified_by")
  modifiedOn          DateTime        @default(now()) @map("modified_on")
  hazardForm          HazardForm      @relation(fields: [idHazardForm], references: [idHazardForm])
  labHasHazards       LabHasHazards[]

  @@index([idHazardForm])
  @@map("hazard_form_history")
}

model LabHasHazards {
  idLabHasHazards     Int                  @id @default(autoincrement()) @map("id_lab_has_hazards")
  idLab               Int                  @map("id_lab")
  idHazardFormHistory Int                  @map("id_hazard_form_history")
  submission          String
  hazardFormHistory   HazardFormHistory    @relation(fields: [idHazardFormHistory], references: [idHazardFormHistory])
  room                Room                 @relation(fields: [idLab], references: [id])
  labHasHazardsChild  LabHasHazardsChild[]

  @@index([idLab])
  @@index([idHazardFormHistory], map: "id_hazard_form_history")
  @@map("lab_has_hazards")
}

model HazardFormChild {
  idHazardFormChild      Int                      @id @default(autoincrement()) @map("id_hazard_form_child")
  idHazardForm           Int                      @map("id_hazard_form")
  hazardFormChildName    String                   @unique @map("hazard_form_child_name") @db.VarChar(200)
  form                   String
  version                String                   @default("1.0.0")
  hazardForm             HazardForm               @relation(fields: [idHazardForm], references: [idHazardForm])
  hazardFormChildHistory HazardFormChildHistory[]

  @@index([idHazardForm], map: "id_hazard_form")
  @@map("hazard_form_child")
}

model HazardFormChildHistory {
  idHazardFormChildHistory Int                  @id @default(autoincrement()) @map("id_hazard_form_child_history")
  idHazardFormChild        Int                  @map("id_hazard_form_child")
  form                     String
  version                  String               @default("1.0.0")
  modifiedBy               String               @map("modified_by")
  modifiedOn               DateTime             @default(now()) @map("modified_on")
  hazardFormChild          HazardFormChild      @relation(fields: [idHazardFormChild], references: [idHazardFormChild])
  labHasHazardsChild       LabHasHazardsChild[]

  @@index([idHazardFormChild], map: "id_hazard_form_child")
  @@map("hazard_form_child_history")
}

model LabHasHazardsChild {
  idLabHasHazardsChild     Int                    @id @default(autoincrement()) @map("id_lab_has_hazards_child")
  idLabHasHazards          Int                    @map("id_lab_has_hazards")
  idHazardFormChildHistory Int                    @map("id_hazard_form_child_history")
  submission               String
  hazardFormChildHistory   HazardFormChildHistory @relation(fields: [idHazardFormChildHistory], references: [idHazardFormChildHistory])
  labHasHazards            LabHasHazards          @relation(fields: [idLabHasHazards], references: [idLabHasHazards])

  @@index([idLabHasHazards], map: "id_lab_has_hazards")
  @@index([idHazardFormChildHistory], map: "id_hazard_form_child_history")
  @@map("lab_has_hazards_child")
}

model MutationLogs {
  idMutationLogs Int      @id @default(autoincrement()) @map("id_mutation_logs")
  modifiedBy     String   @map("modified_by")
  modifiedOn     DateTime @default(now()) @map("modified_on")
  tableName      String   @map("table_name")
  tableId        Int      @map("table_id")
  columnName     String   @map("column_name")
  oldValue       String   @map("old_value")
  newValue       String   @map("new_value")
  action         String

  @@map("mutation_logs")
}

model LabHasHazardsAdditionalInfo {
  idLabHasHazardsAdditionalInfo Int                            @id @default(autoincrement()) @map("id_lab_has_hazards_additional_info")
  idLab                         Int                            @map("id_lab")
  idHazardCategory              Int                            @map("id_hazard_category")
  comment                       String?
  filePath                      String?                        @db.VarChar(250)
  modifiedBy                    String                         @map("modified_by")
  modifiedOn                    DateTime                       @default(now()) @map("modified_on")
  hazardsAdditionalInfoHasFile  HazardsAdditionalInfoHasFile[]
  hazardsAdditionalInfoHasTag   HazardsAdditionalInfoHasTag[]
  hazardCategory                HazardCategory                 @relation(fields: [idHazardCategory], references: [idHazardCategory])
  room                          Room                           @relation(fields: [idLab], references: [id])

  @@index([idLab])
  @@index([idHazardCategory])
  @@map("lab_has_hazards_additional_info")
}

model HazardsAdditionalInfoHasFile {
  idLabHasHazardsAdditionalInfo Int                         @map("id_lab_has_hazards_additional_info")
  filePath                      String                      @map("file_path") @db.VarChar(250)
  labHasHazardsAdditionalInfo   LabHasHazardsAdditionalInfo @relation(fields: [idLabHasHazardsAdditionalInfo], references: [idLabHasHazardsAdditionalInfo], onUpdate: Restrict, map: "lab_has_hazards_additional_info_has_file_ibfk_1")

  @@unique([idLabHasHazardsAdditionalInfo, filePath], name: "unique_hazards_additional_info_has_file", map: "unique_hazards_additional_info_has_file")
  @@index([filePath])
  @@map("hazards_additional_info_has_file")
}

model Authorization {
  idAuthorization           Int                         @id @default(autoincrement()) @map("id_authorization")
  authorization             String                      @unique @db.VarChar(50)
  renewals                  Int
  idUnit                    Int?                        @map("id_unit")
  expirationDate            DateTime?                   @map("expiration_date") @db.Date
  status                    AuthorizationStatus
  creationDate              DateTime                    @map("creation_date") @db.Date
  type                      String
  authority                 String?
  dateExpiryNotified        DateTime?                   @map("date_expiry_notified") @db.Date
  unit                      Unit?                       @relation(fields: [idUnit], references: [id], onUpdate: Restrict, map: "authorization_unit_ibfk_1")
  authorizationHasChemical  AuthorizationHasChemical[]
  authorizationHasFile      AuthorizationHasFile[]
  authorizationHasHolder    AuthorizationHasHolder[]
  authorizationHasRadiation AuthorizationHasRadiation[]
  authorizationHasRoom      AuthorizationHasRoom[]

  @@map("authorization")
}

model AuthorizationHasRoom {
  idAuthorization Int           @map("id_authorization")
  idLab           Int           @map("id_lab")
  authorization   Authorization @relation(fields: [idAuthorization], references: [idAuthorization], onUpdate: Restrict, map: "authorization_has_room_ibfk_1")
  room            Room          @relation(fields: [idLab], references: [id], onUpdate: Restrict, map: "authorization_has_room_ibfk_2")

  @@unique([idAuthorization, idLab], name: "unique_authorization_has_room", map: "unique_authorization_has_room")
  @@index([idLab])
  @@map("authorization_has_room")
}

model AuthorizationHasHolder {
  idAuthorization Int           @map("id_authorization")
  idPerson        Int           @map("id_person")
  authorization   Authorization @relation(fields: [idAuthorization], references: [idAuthorization], onUpdate: Restrict, map: "authorization_has_holder_ibfk_1")
  holder          Person        @relation(fields: [idPerson], references: [idPerson], onUpdate: Restrict, map: "authorization_has_holder_ibfk_2")

  @@unique([idAuthorization, idPerson], name: "unique_authorization_has_holder", map: "unique_authorization_has_holder")
  @@index([idPerson])
  @@map("authorization_has_holder")
}

model AuthorizationHasChemical {
  idAuthorization Int           @map("id_authorization")
  idChemical      Int           @map("id_chemical")
  authorization   Authorization @relation(fields: [idAuthorization], references: [idAuthorization], onUpdate: Restrict, map: "authorization_has_chemical_ibfk_1")
  chemical        AuthChem      @relation(fields: [idChemical], references: [idAuthChem], onUpdate: Restrict, map: "authorization_has_chemical_ibfk_2")

  @@unique([idAuthorization, idChemical], name: "unique_authorization_has_chemical", map: "unique_authorization_has_chemical")
  @@index([idChemical], map: "id_chemical")
  @@map("authorization_has_chemical")
}

model AuthorizationHasRadiation {
  idAuthorization Int           @map("id_authorization")
  source          String
  authorization   Authorization @relation(fields: [idAuthorization], references: [idAuthorization], onUpdate: Restrict, map: "authorization_has_radiation_ibfk_1")

  @@unique([idAuthorization, source], name: "unique_authorization_has_radiation", map: "unique_authorization_has_radiation")
  @@map("authorization_has_radiation")
}

model AuthorizationHasFile {
  idAuthorization Int           @map("id_authorization")
  filePath        String        @map("file_path") @db.VarChar(250)
  authorization   Authorization @relation(fields: [idAuthorization], references: [idAuthorization], onUpdate: Restrict, map: "authorization_has_file_ibfk_1")

  @@unique([idAuthorization, filePath], name: "unique_authorization_has_file", map: "unique_authorization_has_file")
  @@index([filePath])
  @@map("authorization_has_file")
}

model Tag {
  idTag                       Int                           @id @default(autoincrement()) @map("id_tag")
  tagName                     String                        @unique(map: "unique_tag_name") @map("tag_name") @db.VarChar(100)
  hazardsAdditionalInfoHasTag HazardsAdditionalInfoHasTag[]

  @@map("tag")
}

model HazardsAdditionalInfoHasTag {
  idHazardsAdditionalInfoHasTag Int                         @id @default(autoincrement()) @map("id_hazards_additional_info_has_tag")
  idTag                         Int                         @map("id_tag")
  idLabHasHazardsAdditionalInfo Int                         @map("id_lab_has_hazards_additional_info")
  comment                       String?
  labHasHazardsAdditionalInfo   LabHasHazardsAdditionalInfo @relation(fields: [idLabHasHazardsAdditionalInfo], references: [idLabHasHazardsAdditionalInfo])
  tag                           Tag                         @relation(fields: [idTag], references: [idTag])

  @@index([idTag], map: "id_tag")
  @@index([idLabHasHazardsAdditionalInfo], map: "id_lab_has_hazards_additional_info")
  @@map("hazards_additional_info_has_tag")
}

model DispensationSubject {
  idDispensationSubject Int            @id @default(autoincrement()) @map("id_dispensation_subject")
  subject               String         @unique(map: "unique_dispensation_subject") @db.VarChar(60)
  dispensation          Dispensation[]

  @@map("dispensation_subject")
}

model Dispensation {
  idDispensation        Int                     @id @default(autoincrement()) @map("id_dispensation")
  renewals              Int
  idDispensationSubject Int                     @map("id_dispensation_subject")
  subjectOther          String                  @map("subject_other") @db.VarChar(60)
  description           String                  @map("requires")
  comment               String?
  status                DispensationStatus
  dateStart             DateTime                @map("date_start") @db.Date
  dateEnd               DateTime                @map("date_end") @db.Date
  filePath              String?                 @map("file_path") @db.VarChar(250)
  dateExpiryNotified    DateTime?               @map("date_expiry_notified") @db.Date
  createdBy             String                  @map("created_by") @db.VarChar(50)
  createdOn             DateTime                @map("created_on") @db.Timestamp(0)
  modifiedBy            String                  @map("modified_by") @db.VarChar(50)
  modifiedOn            DateTime                @map("modified_on") @db.Timestamp(0)
  subject               DispensationSubject     @relation(fields: [idDispensationSubject], references: [idDispensationSubject], onUpdate: Restrict, map: "dispensation_has_subject_ibfk_1")
  dispensationHasFile   DispensationHasFile[]
  dispensationHasHolder DispensationHasHolder[]
  dispensationHasRoom   DispensationHasRoom[]
  dispensationHasTicket DispensationHasTicket[]
  dispensationHasUnit   DispensationHasUnit[]

  @@map("dispensation")
}

model DispensationHasTicket {
  idDispensation Int          @map("id_dispensation")
  ticketNumber   String       @map("ticket_number")
  dispensation   Dispensation @relation(fields: [idDispensation], references: [idDispensation], onUpdate: Restrict, map: "dispensation_has_ticket_ibfk_1")

  @@unique([idDispensation, ticketNumber], name: "unique_dispensation_has_ticket", map: "unique_dispensation_has_ticket")
  @@index([ticketNumber])
  @@map("dispensation_has_ticket")
}

model DispensationHasFile {
  idDispensation Int          @map("id_dispensation")
  filePath       String       @map("file_path") @db.VarChar(250)
  dispensation   Dispensation @relation(fields: [idDispensation], references: [idDispensation], onUpdate: Restrict, map: "dispensation_has_file_ibfk_1")

  @@unique([idDispensation, filePath], name: "unique_dispensation_has_file", map: "unique_dispensation_has_file")
  @@index([filePath])
  @@map("dispensation_has_file")
}

model DispensationHasHolder {
  idDispensation Int          @map("id_dispensation")
  idPerson       Int          @map("id_person")
  dispensation   Dispensation @relation(fields: [idDispensation], references: [idDispensation], onUpdate: Restrict, map: "dispensation_has_holder_ibfk_1")
  holder         Person       @relation(fields: [idPerson], references: [idPerson], onUpdate: Restrict, map: "dispensation_has_holder_ibfk_2")

  @@unique([idDispensation, idPerson], name: "unique_dispensation_has_holder", map: "unique_dispensation_has_holder")
  @@index([idPerson])
  @@map("dispensation_has_holder")
}

model DispensationHasRoom {
  idDispensation Int          @map("id_dispensation")
  idLab          Int          @map("id_lab")
  dispensation   Dispensation @relation(fields: [idDispensation], references: [idDispensation], onUpdate: Restrict, map: "dispensation_has_room_ibfk_1")
  room           Room         @relation(fields: [idLab], references: [id], onUpdate: Restrict, map: "dispensation_has_room_ibfk_2")

  @@unique([idDispensation, idLab], name: "unique_dispensation_has_room", map: "unique_dispensation_has_room")
  @@index([idLab])
  @@map("dispensation_has_room")
}

model DispensationHasUnit {
  idDispensation Int          @map("id_dispensation")
  idUnit         Int          @map("id_unit")
  dispensation   Dispensation @relation(fields: [idDispensation], references: [idDispensation], onUpdate: Restrict, map: "dispensation_has_unit_ibfk_1")
  unit           Unit         @relation(fields: [idUnit], references: [id], onUpdate: Restrict, map: "dispensation_has_unit_ibfk_2")

  @@unique([idDispensation, idUnit], name: "unique_dispensation_has_unit", map: "unique_dispensation_has_unit")
  @@index([idUnit])
  @@map("dispensation_has_unit")
}

model AssessmentDecisionSubject {
  idAssessmentAndDecisionSubject Int                  @id @default(autoincrement()) @map("id_assessment_and_decision_subject")
  subject                        String               @unique(map: "unique_assessment_and_decision_subject") @db.VarChar(60)
  assessmentAndDecision          AssessmentDecision[]

  @@map("assessment_and_decision_subject")
}

model AssessmentDecision {
  idAssessmentAndDecision         Int                            @id @default(autoincrement()) @map("id_assessment_and_decision")
  idAssessmentAndDecisionSubject  Int                            @map("id_assessment_and_decision_subject")
  subjectOther                    String                         @map("subject_other") @db.VarChar(60)
  description                     String
  conclusion                      String?
  status                          AssessmentDecisionStatus
  date                            DateTime                       @db.Date
  createdBy                       String                         @map("created_by") @db.VarChar(50)
  createdOn                       DateTime                       @map("created_on") @db.Timestamp(0)
  modifiedBy                      String                         @map("modified_by") @db.VarChar(50)
  modifiedOn                      DateTime                       @map("modified_on") @db.Timestamp(0)
  subject                         AssessmentDecisionSubject      @relation(fields: [idAssessmentAndDecisionSubject], references: [idAssessmentAndDecisionSubject], onUpdate: Restrict, map: "assessment_and_decision_has_subject_ibfk_1")
  assessmentAndDecisionHasContact AssessmentDecisionHasContact[]
  assessmentAndDecisionHasFile    AssessmentDecisionHasFile[]
  assessmentAndDecisionHasRoom    AssessmentDecisionHasRoom[]
  assessmentAndDecisionHasTicket  AssessmentDecisionHasTicket[]
  assessmentAndDecisionHasUnit    AssessmentDecisionHasUnit[]

  @@map("assessment_and_decision")
}

model AssessmentDecisionHasFile {
  idAssessmentAndDecision Int                @map("id_assessment_and_decision")
  filePath                String             @map("file_path") @db.VarChar(250)
  assessmentAndDecision   AssessmentDecision @relation(fields: [idAssessmentAndDecision], references: [idAssessmentAndDecision], onUpdate: Restrict, map: "assessment_and_decision_has_file_ibfk_1")

  @@unique([idAssessmentAndDecision, filePath], name: "unique_assessment_and_decision_has_file", map: "unique_assessment_and_decision_has_file")
  @@index([filePath], map: "file_path")
  @@map("assessment_and_decision_has_file")
}

model AssessmentDecisionHasTicket {
  idAssessmentAndDecision Int                @map("id_assessment_and_decision")
  ticketNumber            String             @map("ticket_number")
  assessmentAndDecision   AssessmentDecision @relation(fields: [idAssessmentAndDecision], references: [idAssessmentAndDecision], onUpdate: Restrict, map: "assessment_and_decision_has_ticket_ibfk_1")

  @@unique([idAssessmentAndDecision, ticketNumber], name: "unique_assessment_and_decision_has_ticket", map: "unique_assessment_and_decision_has_ticket")
  @@index([ticketNumber], map: "ticket_number")
  @@map("assessment_and_decision_has_ticket")
}

model AssessmentDecisionHasContact {
  idAssessmentAndDecision Int                @map("id_assessment_and_decision")
  idPerson                Int                @map("id_person")
  assessmentAndDecision   AssessmentDecision @relation(fields: [idAssessmentAndDecision], references: [idAssessmentAndDecision], onUpdate: Restrict, map: "assessment_and_decision_has_contact_ibfk_1")
  contact                 Person             @relation(fields: [idPerson], references: [idPerson], onUpdate: Restrict, map: "assessment_and_decision_has_contact_ibfk_2")

  @@unique([idAssessmentAndDecision, idPerson], name: "unique_assessment_and_decision_has_contact", map: "unique_assessment_and_decision_has_contact")
  @@index([idPerson], map: "id_person")
  @@map("assessment_and_decision_has_contact")
}

model AssessmentDecisionHasRoom {
  idAssessmentAndDecision Int                @map("id_assessment_and_decision")
  idLab                   Int                @map("id_lab")
  assessmentAndDecision   AssessmentDecision @relation(fields: [idAssessmentAndDecision], references: [idAssessmentAndDecision], onUpdate: Restrict, map: "assessment_and_decision_has_room_ibfk_1")
  room                    Room               @relation(fields: [idLab], references: [id], onUpdate: Restrict, map: "assessment_and_decision_has_room_ibfk_2")

  @@unique([idAssessmentAndDecision, idLab], name: "unique_assessment_and_decision_has_room", map: "unique_assessment_and_decision_has_room")
  @@index([idLab], map: "id_lab")
  @@map("assessment_and_decision_has_room")
}

model AssessmentDecisionHasUnit {
  idAssessmentAndDecision Int                @map("id_assessment_and_decision")
  idUnit                  Int                @map("id_unit")
  assessmentAndDecision   AssessmentDecision @relation(fields: [idAssessmentAndDecision], references: [idAssessmentAndDecision], onUpdate: Restrict, map: "assessment_and_decision_has_unit_ibfk_1")
  unit                    Unit               @relation(fields: [idUnit], references: [id], onUpdate: Restrict, map: "assessment_and_decision_has_unit_ibfk_2")

  @@unique([idAssessmentAndDecision, idUnit], name: "unique_assessment_and_decision_has_unit", map: "unique_assessment_and_decision_has_unit")
  @@index([idUnit], map: "id_unit")
  @@map("assessment_and_decision_has_unit")
}

enum AuthorizationStatus {
  Active
  Expired
}

enum DispensationStatus {
  Draft
  Active
  Expired
  Cancelled
}

enum AssessmentDecisionStatus {
  Draft
  Active
  Closed
}
